# Kết nối PostgreSQL Docker Local
DATABASE_URL="postgresql://lms_user:lms_password@localhost:5432/corporate_lms?schema=public"

# Kết nối Redis Local
REDIS_URL="redis://localhost:6379"

# Cổng hoạt động của Backend
PORT=5000

# Bảo mật JWT & HRM Integration (bắt buộc cấu hình, JWT_SECRET >= 32 ký tự)
JWT_SECRET="replace-with-a-strong-secret-at-least-32-chars"
JWT_EXPIRES_IN="24h"
BCRYPT_ROUNDS=10
HRM_API_KEY="replace-with-hrm-integration-api-key"

# Mật khẩu mặc định cho tài khoản Seed Demo (chỉ dùng môi trường dev/local)
SEED_DEMO_PASSWORD="Password123!"
